table SpecialDates
	lineageTag: a010d350-a77b-4ca2-9d6a-22ab563a9216

	measure ButtonLabel = ```
			
			    VAR _selectedperiod = SELECTEDVALUE(SpecialDates[Period])
			    VAR _start = MIN(SpecialDates[Date])
			    VAR _end = MAX(SpecialDates[Date])
			    RETURN SWITCH(true,
			        _selectedperiod = "Custom...",FORMAT(_start,"mm/dd/yy")&" - "&FORMAT(_end,"mm/dd/yy")&" ✎", 
			        _selectedperiod = "Today", FORMAT(_start,"mm/dd/yy") ,
			        _selectedperiod = "Yesterday", FORMAT(_start,"mm/dd/yy") ,
			        _selectedperiod = "This Business Week", FORMAT(_start,"mm/dd/yy")&" - "&FORMAT(_end,"d mmm yy"),
			        _selectedperiod = "Last Business Week", FORMAT(_start,"mm/dd/yy")&" - "&FORMAT(_end-2,"mm/dd/yy"),
			        FORMAT(_start,"mm/dd/yy")&" - "&FORMAT(_end,"mm/dd/yy") 
			    )
			```
		lineageTag: fea8e4dc-fa31-4b07-9f35-861ac3251d9e

	column Date
		formatString: General Date
